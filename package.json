    "t4c2_web.html",
    "README.md",
    "LICENSE",
    "exemples"
  ],
  "scripts": {
    "test": "node --test t4c2.test.js",
    "start": "node t4c2.js",
    "fmt": "node t4c2.js --fmt"
  },
  "engines": {
    "node": ">=18"
  }
}
