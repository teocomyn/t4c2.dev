{
  "name": "t4c2",
  "version": "1.3.0",
  "homepage": "https://github.com/teocomyn/t4c2.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teocomyn/t4c2.dev.git"
  },
  "bugs": {
    "url": "https://github.com/teocomyn/t4c2.dev/issues"
  },
  "description": "Langage de programmation en français.",
  "keywords": ["t4c2", "francais", "language", "interpreter"],
  "license": "MIT",
  "author": "Teo Comyn",
  "type": "commonjs",
  "main": "./t4c2.js",
